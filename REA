    {id:'sam',name:'Sam W.',spec:'Date nights & solo diners',bio:'Reads the room. Chatty if you are, invisible if you are not.',tags:['lowkey','fast','wine'],rating:4.6,status:'yellow',avg:7.0,today:5,trend:0,streak:1,
      week:[['M',7.1],['T',6.9],['W',7.0],['T',7.2],['F',7.0],['S',0],['S',0]],
      fb:[{speed:'yellow',food:'green',engage:'yellow',score:7,note:'Fine overall.',when:'6:05 PM · Table 2'}]}
  ];
  const BY=Object.fromEntries(SERVERS.map(s=>[s.id,s]));
  const MOOD={green:{tok:'--good',label:'On track'},yellow:{tok:'--warn',label:'Watch'},red:{tok:'--bad',label:'Needs attention'}};

  const S={
    role:'guest',
    gtab:'before',
    g:{ prefs:new Set(), matchedId:null, rated:false, rate:{speed:null,food:null,engage:null,score:null} },
    regulars:['maya'],
    mgrSel:null
  };

  const CAP={ guest:"The guest journey: match before, rate after.", crew:"What a server sees about their shift.", manager:"What a manager sees across the floor.", owner:"What the owner sees across the venue." };

  function band(n){ return n<=4?'red':n<=7?'yellow':'green'; }
  function initials(n){ return n.split(' ').map(p=>p[0]).join('').slice(0,2).toUpperCase(); }
  function stars(r){ const f=Math.round(r); return '★'.repeat(f)+'☆'.repeat(5-f); }
  function matchPct(prefs,s){ const base=60+(s.rating-4.4)*18; if(!prefs.size) return Math.round(Math.min(97,base+8)); let hit=0; prefs.forEach(p=>{if(s.tags.includes(p))hit++;}); return Math.round(Math.min(98,55+(hit/prefs.size)*42+(s.rating-4.4)*10)); }
  function smiley(kind,size){ const m=kind==='green'?'M15 36 Q32 49 49 36':kind==='yellow'?'M18 39 L46 39':'M15 44 Q32 33 49 44'; const c=`var(${MOOD[kind].tok})`;
    return `<svg viewBox="0 0 64 64" width="${size}" height="${size}" aria-hidden="true" style="flex:none"><circle cx="32" cy="32" r="29" fill="color-mix(in srgb, ${c} 13%, transparent)" stroke="${c}" stroke-width="2.6"/><circle cx="23" cy="26" r="3.4" fill="${c}"/><circle cx="41" cy="26" r="3.4" fill="${c}"/><path d="${m}" fill="none" stroke="${c}" stroke-width="3" stroke-linecap="round"/></svg>`; }

  /* ---------------- GUEST ---------------- */
  function guest(){
    const sub=`<div class="subseg">
      <button class="${S.gtab==='before'?'on':''}" data-action="gtab" data-value="before">1 · Before</button>
      <button class="${S.gtab==='after'?'on':''}" data-action="gtab" data-value="after">2 · After</button>
      <button class="${S.gtab==='regulars'?'on':''}" data-action="gtab" data-value="regulars">Regulars</button>
    </div>`;
    return `<div class="scr">${sub}${S.gtab==='before'?guestBefore():S.gtab==='after'?guestAfter():guestRegulars()}</div>`;
  }
  function guestBefore(){
    const g=S.g;
    if(g.matchedId){ const s=BY[g.matchedId]; const pct=matchPct(g.prefs,s);
      return `<div class="centerscr" style="padding-top:20px">
        <div class="big">It's a pairing!</div>
        <div class="avatar av">${initials(s.name)}</div>
        <div style="font-family:Anton,sans-serif; font-size:20px">${s.name}</div>
        <p><b style="color:var(--accent)">${pct}% match.</b> ${s.name.split(' ')[0]} will take care of your table tonight.</p>
        <div class="note">"Can't wait to take care of you. Be right over." — ${s.name.split(' ')[0]}</div>
        <button class="cta" data-action="go-after" style="margin-top:16px">After your meal, rate the visit →</button>
        <button class="cta ghost" data-action="rematch" style="margin-top:4px; flex:none">Start over</button>
      </div>`;
    }
    const ranked=SERVERS.slice().sort((a,b)=>matchPct(g.prefs,b)-matchPct(g.prefs,a));
    return `<div style="display:flex; flex-direction:column; flex:1; min-height:0">
      <div class="eyebrow">Before you sit · find your server</div>
      <h2 style="font-size:19px; margin:3px 0 4px">What are you in the mood for?</h2>
      <div class="prefs" style="margin-bottom:12px">${Object.entries(TAGS).map(([k,t])=>`<button class="pchip" data-action="pref" data-value="${k}" aria-pressed="${g.prefs.has(k)}"><span>${t.ic}</span>${t.l}</button>`).join('')}</div>
      <div class="seclabel">Your best matches</div>
      <div style="overflow-y:auto; flex:1">
        ${ranked.map(s=>{ const pct=matchPct(g.prefs,s); return `<div class="mrow" style="flex-wrap:wrap">
          <div class="avatar" style="width:42px;height:42px;font-size:15px">${initials(s.name)}</div>
          <div style="flex:1; min-width:0"><div class="nm">${s.name}</div><div class="mt"><span class="stars">${stars(s.rating)}</span> ${s.rating.toFixed(1)} · ${s.spec}</div></div>
          <div><div class="pct tnum">${pct}%</div><div class="pl">match</div></div>
          <button class="reqbtn" data-action="pairwith" data-value="${s.id}">Request</button>
          <div class="tagwrap" style="flex-basis:100%">${s.tags.map(t=>`<span class="tg ${g.prefs.has(t)?'on':''}">${TAGS[t].ic} ${TAGS[t].l}</span>`).join('')}</div>
        </div>`; }).join('')}
      </div>
    </div>`;
  }
  function moodQ(key,title,labels){ const sel=S.g.rate[key];
    return `<div class="q"><div class="qlabel">${title}</div><div class="qopts">${['green','yellow','red'].map(k=>`<button class="qopt ${k} ${sel===k?'sel':''}" data-action="rq" data-key="${key}" data-value="${k}">${smiley(k,30)}<span>${labels[k]}</span></button>`).join('')}</div></div>`;
  }
  function guestAfter(){
    const g=S.g;
    if(g.rated){ const ov=g.rate.score==null?'green':band(g.rate.score); const sv=g.matchedId?BY[g.matchedId]:BY.maya;
      return `<div class="centerscr" style="padding-top:24px">
        ${smiley(ov,58).replace('<svg','<svg style="margin-bottom:12px"')}
        <h2>Thanks for the feedback</h2>
        <p>It goes to the manager, and ${sv.name.split(' ')[0]}'s scorecard updates in real time.</p>
        <button class="cta" data-action="add-regular" data-value="${sv.id}" style="margin-top:18px">${S.regulars.includes(sv.id)?'✓ In your regulars':'Add '+sv.name.split(' ')[0]+' to regulars'}</button>
        <button class="cta ghost" data-action="rate-again" style="margin-top:4px; flex:none">Start over</button>
      </div>`;
    }
    const sv=g.matchedId?BY[g.matchedId]:BY.maya; const nums=Array.from({length:10},(_,i)=>i+1); const r=g.rate;
    const ready=r.speed&&r.food&&r.engage&&r.score;
    return `<div style="display:flex; flex-direction:column; flex:1; min-height:0; overflow-y:auto">
      <div class="eyebrow">After your meal · rate the visit</div>
      <div style="display:flex; align-items:center; gap:11px; margin:6px 0 0"><div class="avatar" style="width:38px;height:38px;font-size:14px">${initials(sv.name)}</div><div style="font-family:Anton,sans-serif;font-size:17px">How was ${sv.name.split(' ')[0]}?</div></div>
      ${moodQ('speed','Speed of service',{green:'Fast',yellow:'Okay',red:'Slow'})}
      ${moodQ('food','Food came out right',{green:'Spot on',yellow:'Mix-up',red:'Wrong'})}
      ${moodQ('engage','Friendly & attentive',{green:'Great',yellow:'Okay',red:'Lacking'})}
      <div class="q"><div class="qlabel">Overall experience <span class="muted">out of 10</span></div><div class="scale">${nums.map(n=>`<button class="num band-${band(n)} ${r.score===n?'sel':''}" data-action="rscore" data-value="${n}">${n}</button>`).join('')}</div></div>
      <button class="cta" data-action="submit-rate" style="margin-top:14px" ${ready?'':'disabled'}>${ready?'Send feedback':'Answer all four'}</button>
    </div>`;
  }
  function guestRegulars(){
    if(!S.regulars.length){ return `<div class="centerscr"><div style="font-size:38px">💛</div><div style="font-family:Anton,sans-serif;font-size:18px">No regulars yet</div><p>Pair with a server and add them here for one-tap requests next time.</p></div>`; }
    return `<div style="display:flex; flex-direction:column; flex:1; min-height:0; overflow-y:auto">
      <div class="eyebrow">Your regulars</div>
      <h2 style="font-size:19px; margin:3px 0 12px">Favorites, one tap away</h2>
      ${S.regulars.map(id=>{ const s=BY[id]; return `<div class="mrow" style="flex-wrap:wrap">
        <div class="avatar" style="width:42px;height:42px;font-size:15px">${initials(s.name)}</div>
        <div style="flex:1; min-width:0"><div class="nm">${s.name}</div><div class="mt"><span class="stars">${stars(s.rating)}</span> ${s.rating.toFixed(1)} · ${s.spec}</div></div>
        <button class="reqbtn" data-action="request-again" data-value="${id}">Request again</button>
      </div>`; }).join('')}
    </div>`;
  }

  /* ---------------- CREW ---------------- */
  function crew(){
    const me=BY.maya; const max=10;
    return `<div class="scr" style="padding-bottom:0">
      <div style="display:flex; align-items:center; justify-content:space-between; padding:4px 2px 10px">
        <div><div class="eyebrow">Your shift · Friday</div><h2 style="font-size:19px">Hey, Maya</h2></div><div class="avatar" style="width:38px;height:38px;font-size:14px">MR</div>
      </div>
      <div class="scorewrap" style="margin-bottom:14px">${smiley('green',48)}<div><div class="muted" style="font-size:12px">You're</div><div class="bignum" style="color:var(--good)">On track</div></div>
        <div style="margin-left:auto;text-align:right"><div style="font-family:Anton,sans-serif;font-size:24px">${me.avg.toFixed(1)}</div><div class="mt" style="font-size:11px;color:var(--muted)">avg / 10</div></div></div>
      <div class="stat3" style="margin-bottom:16px"><div class="stat"><div class="n tnum">${me.today}</div><div class="k">ratings today</div></div><div class="stat"><div class="n tnum">${me.streak}</div><div class="k">day streak</div></div><div class="stat"><div class="n tnum">3</div><div class="k">asking for you</div></div></div>
      <div class="seclabel">This week</div>
      <div class="week" style="margin-bottom:16px">${me.week.map(([d,v])=>`<div class="day"><div class="bar" style="height:${v?Math.max(10,(v/max)*50):6}px; background:${v?'var(--good)':'var(--line)'}"></div><div class="dl">${d}</div></div>`).join('')}</div>
      <div class="seclabel">What guests said</div>
      <div class="list" style="padding-bottom:16px">${me.fb.map(fbCard).join('')}</div>
    </div>`;
  }
  function fbCard(f){ const dims=[['Speed',f.speed],['Food',f.food],['Service',f.engage]];
    return `<div class="fbcard"><div class="fbdims">${dims.map(([l,m])=>`<div class="fbdim">${smiley(m,22)}<span>${l}</span></div>`).join('')}<div class="fbdim"><span class="scorebadge band-${band(f.score)}">${f.score}</span><span>of 10</span></div></div>${f.note?`<div class="nt">${f.note}</div>`:''}<div class="meta">${f.when}</div></div>`;
  }

  /* ---------------- MANAGER ---------------- */
  function manager(){
    if(S.mgrSel){ const s=BY[S.mgrSel];
      return `<div class="scr" style="padding-bottom:0">
        <button class="cta ghost" data-action="mgr-back" style="align-self:flex-start; width:auto; padding:6px 0; margin-bottom:4px">‹ Floor</button>
        <div class="scorewrap" style="margin-bottom:14px"><div class="avatar" style="width:50px;height:50px;font-size:18px">${initials(s.name)}</div><div style="flex:1;min-width:0"><div style="font-family:Anton,sans-serif;font-size:20px">${s.name}</div><div style="margin-top:6px"><span class="pill ${s.status}">${smiley(s.status,15)} ${MOOD[s.status].label}</span></div></div>${smiley(s.status,40)}</div>
        <div class="stat3" style="margin-bottom:16px"><div class="stat"><div class="n tnum">${s.avg.toFixed(1)}</div><div class="k">avg / 10</div></div><div class="stat"><div class="n tnum">${s.today}</div><div class="k">today</div></div><div class="stat"><div class="n tnum">${s.trend>=0?'+':''}${s.trend.toFixed(1)}</div><div class="k">vs last</div></div></div>
        <div class="seclabel">Recent feedback</div><div class="list" style="padding-bottom:16px">${s.fb.map(fbCard).join('')}</div>
      </div>`;
    }
    const counts={green:0,yellow:0,red:0}; SERVERS.forEach(s=>counts[s.status]++);
    const rows=SERVERS.slice().sort((a,b)=>a.avg-b.avg);
    return `<div class="scr" style="padding-bottom:0">
      <div style="display:flex; align-items:center; justify-content:space-between; padding:4px 2px 12px"><div><div class="eyebrow">Riverside Grill · live</div><h2 style="font-size:19px">Floor today</h2></div><div class="muted tnum" style="font-size:12px;text-align:right">Fri · Dinner<br>43 ratings</div></div>
      <div class="summary"><div class="sumcard green"><div class="n">${counts.green}</div><div class="k">On track</div></div><div class="sumcard yellow"><div class="n">${counts.yellow}</div><div class="k">Watch</div></div><div class="sumcard red"><div class="n">${counts.red}</div><div class="k">Needs attn</div></div></div>
      <div class="seclabel">Crew · tap for detail</div>
      <div class="list" style="padding-bottom:16px">${rows.map(s=>{ const tc=s.trend>0?'up':s.trend<0?'down':'flat'; const ta=s.trend>0?'▲':s.trend<0?'▼':'–';
        return `<button class="row tap" data-action="mgr-open" data-value="${s.id}"><div class="avatar" style="width:38px;height:38px;font-size:14px">${initials(s.name)}</div>${smiley(s.status,28)}<div><div class="nm">${s.name}</div><div class="mt tnum">${s.avg.toFixed(1)} / 10 · ${s.today} today</div></div><div class="right"><span class="trend ${tc} tnum">${ta} ${Math.abs(s.trend).toFixed(1)}</span></div></button>`; }).join('')}</div>
    </div>`;
  }

  /* ---------------- OWNER ---------------- */
  function owner(){
    const dims=[['Speed','yellow','7.6'],['Food','green','8.9'],['Service','green','8.5'],['Overall','green','8.3']];
    const locs=[['Riverside · Main','green',8.6],['Westside','yellow',7.5],['Airport','green',8.1]];
    const max=10; const week=[['M',8.1],['T',8.5],['W',8.3],['T',8.0],['F',8.6],['S',0],['S',0]];
    return `<div class="scr" style="padding-bottom:0">
      <div style="display:flex; align-items:center; justify-content:space-between; padding:4px 2px 12px"><div><div class="eyebrow">Riverside Grill · this week</div><h2 style="font-size:19px">The whole venue</h2></div><div class="avatar" style="width:38px;height:38px;font-size:14px">RG</div></div>
      <div class="scorewrap" style="margin-bottom:14px">${smiley('green',46)}<div><div class="muted" style="font-size:12px">Guests are</div><div class="bignum" style="color:var(--good)">Happy</div></div><div style="margin-left:auto;text-align:right"><div style="font-family:Anton,sans-serif;font-size:24px">8.3</div><div class="mt" style="font-size:11px;color:var(--muted)">avg / 10</div></div></div>
      <div class="stat3" style="margin-bottom:16px"><div class="stat"><div class="n tnum">312</div><div class="k">ratings</div></div><div class="stat"><div class="n tnum">4.6</div><div class="k">★ public</div></div><div class="stat"><div class="n tnum">96</div><div class="k">new regulars</div></div></div>
      <div class="seclabel">By question</div>
      <div class="dims4" style="margin-bottom:16px">${dims.map(([l,st,v])=>`<div class="dimc">${smiley(st,24)}<div class="dv">${v}</div><div class="dk">${l}</div></div>`).join('')}</div>
      <div class="seclabel">This week</div>
      <div class="week" style="margin-bottom:16px">${week.map(([d,v])=>`<div class="day"><div class="bar" style="height:${v?Math.max(10,(v/max)*50):6}px; background:${v?'var(--good)':'var(--line)'}"></div><div class="dl">${d}</div></div>`).join('')}</div>
      <div class="seclabel">Locations</div>
      <div class="list" style="padding-bottom:16px">${locs.map(([n,st,v])=>`<div class="row"><div class="avatar" style="width:34px;height:34px;font-size:12px;background:var(--panel);color:var(--muted)">${n[0]}</div>${smiley(st,26)}<div><div class="nm">${n}</div><div class="mt tnum">${v.toFixed(1)} / 10</div></div><div class="right"><span class="pill ${st}" style="font-size:10px">${MOOD[st].label}</span></div></div>`).join('')}</div>
    </div>`;
  }

  /* ---------------- render ---------------- */
  function render(){
    caption.textContent=CAP[S.role];
    document.querySelectorAll('.seg button').forEach(b=>b.setAttribute('aria-selected', b.dataset.value===S.role));
    screen.innerHTML = S.role==='guest'?guest():S.role==='crew'?crew():S.role==='manager'?manager():owner();
  }

  document.body.addEventListener('click',e=>{
    const el=e.target.closest('[data-action]'); if(!el) return;
    const a=el.dataset.action, v=el.dataset.value;
    switch(a){
      case 'theme':{ const root=document.documentElement; const dark=root.getAttribute('data-theme')==='dark'||(!root.getAttribute('data-theme')&&matchMedia('(prefers-color-scheme:dark)').matches); root.setAttribute('data-theme',dark?'light':'dark'); return; }
      case 'role': S.role=v; S.mgrSel=null; render(); return;
      case 'gtab': S.gtab=v; render(); return;
      case 'pref': S.g.prefs.has(v)?S.g.prefs.delete(v):S.g.prefs.add(v); render(); return;
      case 'pairwith': S.g.matchedId=v; render(); return;
      case 'rematch': S.g.matchedId=null; render(); return;
      case 'go-after': S.gtab='after'; render(); return;
      case 'rq': S.g.rate[el.dataset.key]=v; render(); return;
      case 'rscore': S.g.rate.score=+v; render(); return;
      case 'submit-rate': S.g.rated=true; render(); return;
      case 'rate-again': S.g.rate={speed:null,food:null,engage:null,score:null}; S.g.rated=false; S.gtab='before'; S.g.matchedId=null; render(); return;
      case 'add-regular': if(!S.regulars.includes(v)) S.regulars.push(v); render(); return;
      case 'request-again': S.g.matchedId=v; S.gtab='before'; render(); return;
      case 'mgr-open': S.mgrSel=v; render(); return;
      case 'mgr-back': S.mgrSel=null; render(); return;
    }
  });

  render();
})();
</script>

</body></html>
