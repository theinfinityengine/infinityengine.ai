<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Infinity Engine Coming Soon</title>
<style>
  :root{--paper:#fff;--muted:#f3e7ff;
    --ui:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;}
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%;overflow:hidden;background:#0e0a2e}
  body{font-family:var(--ui);color:var(--paper);-webkit-tap-highlight-color:transparent;position:relative}

  /* Golden Hour vertical gradient */
  .backdrop{position:fixed;inset:0;z-index:0;
    background:linear-gradient(180deg,
      #0e0a2e 0%,#241356 16%,#451f6a 32%,#742668 48%,
      #a8386a 62%,#d4575e 76%,#f0834c 88%,#ffc24d 100%);}

  canvas{position:fixed;inset:0;z-index:1;display:block;touch-action:none}
  .scrim{position:fixed;inset:0;z-index:2;pointer-events:none;
    background:radial-gradient(44% 32% at 50% 48%,rgba(14,8,40,.42),transparent 68%);}

  .wrap{position:fixed;inset:0;z-index:3;display:flex;flex-direction:column;align-items:center;justify-content:center;
    text-align:center;padding:32px 22px;}
  .logo{width:clamp(64px,9vw,92px);height:clamp(64px,9vw,92px);border-radius:24%;display:grid;place-items:center;
    background:linear-gradient(150deg,#a855f7,#6a6ff0 55%,#4f8ef7);
    box-shadow:0 14px 50px rgba(139,92,246,.55),0 0 90px rgba(255,170,90,.3),inset 0 1px 2px rgba(255,255,255,.45);}
  .logo svg{width:60%;height:60%}
  .soon{margin:clamp(20px,3vh,32px) 0 clamp(24px,4vh,40px);font-size:clamp(11px,1.4vw,13px);letter-spacing:.4em;
    font-weight:700;text-transform:uppercase;color:#fff;padding:.6rem 1.3rem;border-radius:100px;
    border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.08);}
  .wordmark{font-family:var(--ui);font-weight:800;line-height:.92;letter-spacing:-.02em;
    font-size:clamp(52px,10.5vw,122px);text-transform:uppercase;filter:drop-shadow(0 8px 44px rgba(20,8,40,.5));}
  .wordmark span{display:block;-webkit-background-clip:text;background-clip:text;color:transparent;
    background-size:240% 240%;animation:flow 10s ease-in-out infinite;}
  .wordmark .a{background-image:linear-gradient(110deg,#ffffff,#ffe8c2 44%,#ffffff);}
  .wordmark .b{background-image:linear-gradient(110deg,#fff0b0,#ffb27a 34%,#ff92b8 66%,#c7a3ff 100%);animation-delay:-3.5s;}
  @keyframes flow{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
  @media (prefers-reduced-motion: reduce){.wordmark span{animation:none}}
  .tagline{margin-top:clamp(22px,3.2vh,34px);font-size:clamp(16px,2vw,22px);color:var(--muted);font-weight:400;
    text-shadow:0 2px 20px rgba(20,8,40,.45);}
  .inq{margin-top:clamp(30px,5vh,52px);font-size:clamp(12px,1.5vw,15px);color:#f0e4ff;font-weight:500;}
  .email{margin-top:.9rem;display:inline-block;text-decoration:none;font-weight:700;color:#fff;
    font-size:clamp(14px,1.8vw,18px);padding:.75rem 1.7rem;border-radius:100px;background-size:200% 200%;
    background-image:linear-gradient(100deg,#9b4bd0,#ff7a5c 50%,#ffc24d);box-shadow:0 10px 44px rgba(255,122,92,.4);
    transition:.3s;animation:flow 9s ease-in-out infinite;}
  .email:hover{filter:brightness(1.08);transform:translateY(-1px)}
</style>
</head>
<body>
  <div class="backdrop"></div>
  <canvas id="stage"></canvas>
  <div class="scrim"></div>
  <div class="wrap">
    <div class="logo">
      <svg viewBox="0 0 96 96" fill="none"><path d="M48 48 C48 33 26 33 26 48 C26 63 48 63 48 48 C48 33 70 33 70 48 C70 63 48 63 48 48 Z"
        stroke="#fff" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div class="soon">Coming soon</div>
    <div class="wordmark"><span class="a">Infinity</span><span class="b">Engine</span></div>
    <div class="tagline">Our site is on the way.</div>
    <div class="inq">For inquiries:</div>
    <a class="email" href="mailto:ash@infinityengine.ai">ash@infinityengine.ai</a>
  </div>

<script>
(() => {
  const FONT="-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif";
  const CLOUD=[255,232,210], GOLD='#fff0b0';
  const canvas=document.getElementById('stage'),ctx=canvas.getContext('2d');
  const reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let W,H,DPR,stars=[],sparkles=[],clouds=[];

  function makeStars(){stars=[];const N=Math.min(120,Math.floor(W*H/11000));
    for(let i=0;i<N;i++){const yr=Math.random();stars.push({x:Math.random()*W,y:yr*H*0.8,r:Math.random()*1.3+0.3,
      a:(0.2+Math.random()*0.6)*(1-yr*0.6),tw:Math.random()*6.28,tws:0.008+Math.random()*0.03,
      c:Math.random()<0.7?'#ffffff':'#ffe3c4'});}}
  function makeSparkles(){sparkles=[];const N=Math.max(3,Math.floor(W/420));
    for(let i=0;i<N;i++)sparkles.push({x:0.12*W+Math.random()*W*0.76,y:0.06*H+Math.random()*H*0.42,
      s:7+Math.random()*7,tw:Math.random()*6.28,tws:0.02+Math.random()*0.02,c:i===0?GOLD:'#ffffff'});}
  function makeClouds(){clouds=[];const N=3;
    for(let i=0;i<N;i++)clouds.push({x:Math.random()*W,y:(0.34+i*0.12+Math.random()*0.05)*H,
      w:(0.42+Math.random()*0.3)*W,h:(0.05+Math.random()*0.04)*H,a:0.05+Math.random()*0.05,
      dx:(0.1+Math.random()*0.15)*(Math.random()<0.5?-1:1)});}
  function resize(){DPR=Math.min(window.devicePixelRatio||1,2);W=innerWidth;H=innerHeight;
    canvas.width=W*DPR;canvas.height=H*DPR;canvas.style.width=W+'px';canvas.style.height=H+'px';
    ctx.setTransform(DPR,0,0,DPR,0,0);makeStars();makeSparkles();makeClouds();}
  resize();addEventListener('resize',resize);

  // ∞ app-icon face for the bills
  const faceCv=document.createElement('canvas');faceCv.width=faceCv.height=96;const fcx=faceCv.getContext('2d');
  function rr(c,x,y,w,h,r){c.beginPath();c.moveTo(x+r,y);c.arcTo(x+w,y,x+w,y+h,r);c.arcTo(x+w,y+h,x,y+h,r);c.arcTo(x,y+h,x,y,r);c.arcTo(x,y,x+w,y,r);c.closePath();}
  (function(){const g=fcx.createLinearGradient(14,14,82,82);g.addColorStop(0,'#a855f7');g.addColorStop(.55,'#6a6ff0');g.addColorStop(1,'#4f8ef7');
    rr(fcx,12,12,72,72,20);fcx.fillStyle=g;fcx.fill();
    fcx.beginPath();fcx.moveTo(48,49);
    fcx.bezierCurveTo(48,49-0.62*17,48-0.92*17,49-0.62*17,48-0.92*17,49);
    fcx.bezierCurveTo(48-0.92*17,49+0.62*17,48,49+0.62*17,48,49);
    fcx.bezierCurveTo(48,49-0.62*17,48+0.92*17,49-0.62*17,48+0.92*17,49);
    fcx.bezierCurveTo(48+0.92*17,49+0.62*17,48,49+0.62*17,48,49);
    fcx.lineWidth=8;fcx.lineCap='round';fcx.lineJoin='round';fcx.strokeStyle='#fff';fcx.stroke();})();

  const DENOMS=[{v:1,tint:'#8bbf6c'},{v:20,tint:'#7fb56a'},{v:100,tint:'#9ac97e'}];
  const backs={'#8bbf6c':'#3f6b46','#7fb56a':'#3a6242','#9ac97e':'#436b4e'};
  function pick(){const r=Math.random();return r<0.5?DENOMS[2]:r<0.8?DENOMS[1]:DENOMS[0];}
  const bills=[];const MAX=reduced?26:64;
  function Bill(x,y,vx,vy,sz){const d=pick();return{x,y,vx,vy,w:sz,h:sz*0.44,ang:Math.random()*6.28,
    spin:(Math.random()-0.5)*0.05,flut:Math.random()*6.28,flutSpeed:0.03+Math.random()*0.03,d};}
  function spawn(b){if(bills.length>=MAX)bills.shift();bills.push(b);}
  function rr2(c,x,y,w,h,r){c.beginPath();c.moveTo(x+r,y);c.arcTo(x+w,y,x+w,y+h,r);c.arcTo(x+w,y+h,x,y+h,r);c.arcTo(x,y+h,x,y,r);c.arcTo(x,y,x+w,y,r);c.closePath();}
  function drawBill(b){const fl=Math.cos(b.flut),sx=Math.max(0.08,Math.abs(fl)),front=fl>=0,w=b.w,h=b.h;
    ctx.save();ctx.translate(b.x,b.y);ctx.rotate(b.ang);ctx.scale(sx,1);
    ctx.shadowColor='rgba(0,0,0,0.35)';ctx.shadowBlur=8;ctx.shadowOffsetY=4;
    if(!front){rr2(ctx,-w/2,-h/2,w,h,4);ctx.fillStyle=backs[b.d.tint];ctx.fill();ctx.shadowColor='transparent';
      rr2(ctx,-w/2+4,-h/2+4,w-8,h-8,3);ctx.strokeStyle='rgba(255,255,255,.15)';ctx.lineWidth=1;ctx.stroke();
      ctx.fillStyle='rgba(0,0,0,.18)';ctx.font='700 '+(h*0.5)+'px '+FONT;ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('$',0,0);ctx.restore();return;}
    rr2(ctx,-w/2,-h/2,w,h,4);ctx.fillStyle=b.d.tint;ctx.fill();ctx.shadowColor='transparent';
    const g=ctx.createLinearGradient(0,-h/2,0,h/2);g.addColorStop(0,'rgba(255,255,255,.22)');g.addColorStop(.5,'rgba(255,255,255,0)');g.addColorStop(1,'rgba(0,0,0,.12)');
    rr2(ctx,-w/2,-h/2,w,h,4);ctx.fillStyle=g;ctx.fill();
    rr2(ctx,-w/2+3.5,-h/2+3.5,w-7,h-7,3);ctx.strokeStyle='rgba(15,42,28,.5)';ctx.lineWidth=1;ctx.stroke();
    ctx.beginPath();ctx.ellipse(0,0,h*0.34,h*0.34,0,0,6.28);ctx.fillStyle='rgba(236,233,255,.22)';ctx.fill();
    ctx.strokeStyle='rgba(15,42,28,.4)';ctx.lineWidth=1;ctx.stroke();
    ctx.fillStyle='rgba(15,42,28,.8)';ctx.textAlign='center';ctx.textBaseline='middle';ctx.font='700 '+(h*0.24)+'px '+FONT;
    ctx.fillText(b.d.v,-w/2+w*0.16,-h/2+h*0.26);ctx.fillText(b.d.v,w/2-w*0.16,h/2-h*0.26);
    const dia=h*0.64;ctx.drawImage(faceCv,-dia/2,-dia/2,dia,dia);ctx.restore();}

  function drawSky(){
    for(const c of clouds){c.x+=c.dx;if(c.x-c.w/2>W)c.x=-c.w/2;if(c.x+c.w/2<0)c.x=W+c.w/2;
      ctx.save();ctx.translate(c.x,c.y);ctx.scale(1,c.h/c.w);
      const g=ctx.createRadialGradient(0,0,0,0,0,c.w/2),cc=CLOUD;
      g.addColorStop(0,'rgba('+cc[0]+','+cc[1]+','+cc[2]+','+c.a+')');
      g.addColorStop(.6,'rgba('+cc[0]+','+cc[1]+','+cc[2]+','+(c.a*0.5)+')');
      g.addColorStop(1,'rgba('+cc[0]+','+cc[1]+','+cc[2]+',0)');
      ctx.fillStyle=g;ctx.beginPath();ctx.arc(0,0,c.w/2,0,6.28);ctx.fill();ctx.restore();}
    for(const s of stars){s.tw+=s.tws;const a=s.a*(0.45+0.55*(0.5+0.5*Math.sin(s.tw)));
      ctx.globalAlpha=a;ctx.fillStyle=s.c;ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,6.28);ctx.fill();}
    ctx.globalAlpha=1;
    for(const s of sparkles){s.tw+=s.tws;const k=0.55+0.45*(0.5+0.5*Math.sin(s.tw)),L=s.s*(0.9+0.2*k),w=s.s*0.16;
      ctx.save();ctx.translate(s.x,s.y);ctx.globalAlpha=0.55+0.45*k;ctx.fillStyle=s.c;ctx.shadowColor=s.c;ctx.shadowBlur=14;
      ctx.beginPath();ctx.moveTo(0,-L);ctx.quadraticCurveTo(w,0,0,L);ctx.quadraticCurveTo(-w,0,0,-L);ctx.fill();
      ctx.beginPath();ctx.moveTo(-L,0);ctx.quadraticCurveTo(0,w,L,0);ctx.quadraticCurveTo(0,-w,-L,0);ctx.fill();
      ctx.restore();ctx.globalAlpha=1;ctx.shadowBlur=0;ctx.shadowColor='transparent';}
  }

  let acc=0;const G=0.03;
  function frame(){ctx.clearRect(0,0,W,H);drawSky();
    acc+=reduced?0.06:0.22;while(acc>=1){spawn(Bill(Math.random()*W,-50,(Math.random()-0.5)*0.4,0.5+Math.random()*0.7,44+Math.random()*26));acc-=1;}
    for(let i=bills.length-1;i>=0;i--){const b=bills[i];b.vy+=G;b.vy=Math.min(b.vy,2.4);b.x+=b.vx;b.y+=b.vy;
      b.ang+=b.spin;b.flut+=b.flutSpeed;b.x+=Math.sin(b.flut)*0.3;drawBill(b);if(b.y-60>H||b.x<-140||b.x>W+140)bills.splice(i,1);}
    requestAnimationFrame(frame);}
  frame();

  addEventListener('pointerdown',e=>{if(e.target.closest('a'))return;
    for(let i=0;i<6;i++){const a=Math.random()*Math.PI-Math.PI,sp=2+Math.random()*4;
      spawn(Bill(e.clientX,e.clientY,Math.cos(a)*sp,Math.sin(a)*sp-2,44+Math.random()*24));}});
})();
</script>
</body>
</html>
